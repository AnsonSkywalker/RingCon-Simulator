# AIGC note: sdkconfig.defaults for env:esp32classic (ESP-IDF, original ESP32).
# The whole point of a custom sdkconfig: the prebuilt Arduino core libbt.a
# ships with the classic HID device profile compiled out; here we enable it.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_DEVICE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
